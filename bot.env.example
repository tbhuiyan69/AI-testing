# Copy to .env to override defaults. API keys are read from your Windows env vars if not set here.
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
ALPACA_PAPER_TRADE=true

BOT_WATCHLIST=NBIS,APLD,CRWV,QMCO,KO,AMZN,META,AMD,QCOM,NVDA,TSLA,HIMS,SOFI,AAPL,IREN,XOM,QQQ,SPY
BOT_FAST_SMA=10
BOT_SLOW_SMA=30

BOT_MIN_DTE=21
BOT_MAX_DTE=45
BOT_TARGET_DELTA=0.40
BOT_MAX_SPREAD_PCT=0.10
BOT_MIN_OPEN_INTEREST=100

BOT_MAX_CONTRACTS=1
BOT_MAX_TRADE_DOLLARS=1000
BOT_MAX_OPEN_POSITIONS=3
BOT_DAILY_LOSS_LIMIT_PCT=0.03

BOT_TAKE_PROFIT_PCT=0.50
BOT_STOP_LOSS_PCT=0.35
BOT_SHORT_DTE_STOP_LOSS_PCT=0.50
BOT_EXIT_DTE=7
BOT_APPROVAL_SECONDS=60
BOT_AUTO_APPROVE_BELOW=100
BOT_PROFIT_LOCK_DOLLARS=5
